# Separate OneJournal VPS only; do not install or activate on one-prod.
[Unit]
Description=OneJournal isolated encrypted backup (requires separate activation)
After=postgresql.service

[Service]
Type=oneshot
Slice=onejournal.slice
ExecStart=/bin/sh /opt/onejournal/current/commands/run_hosted_backup.sh
UMask=0077
CPUQuota=25%
MemoryMax=512M
Nice=10
StandardOutput=journal
StandardError=journal
